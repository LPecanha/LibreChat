EXT_PORT=3092
CORS_ORIGINS=http://localhost:3091,http://localhost:3080

# ── App config (Navvia only) ──────────────────────────────────────────────────
# MONGO_URI       — URI do MongoDB do Navvia (mesmo db do LibreChat)
# JWT_SECRET      — JWT_SECRET do LibreChat (validação de tokens)
# LIBRECHAT_URL   — URL pública do LibreChat
# LIBRECHAT_INTERNAL_URL — opcional, URL Docker interna (server-to-server)
MONGO_URI=mongodb://localhost:27017/LibreChat
JWT_SECRET=your-librechat-jwt-secret-here
LIBRECHAT_URL=http://localhost:3080
LIBRECHAT_INTERNAL_URL=http://localhost:3080

# ── Pagamentos (ASAAS) ────────────────────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_SANDBOX=false
ASAAS_WEBHOOK_TOKEN=

# ── Scheduler ─────────────────────────────────────────────────────────────────
CREDIT_SCHEDULER_CRON=0 * * * *

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
