# =============================================================================
# Navvia — Configuração unificada (LibreChat + Admin Ext + Admin Panel)
# =============================================================================
# Single source of truth. Copie pra .env e preencha os valores.
#
#   cp .env.example .env
#   $EDITOR .env
#   ./navvia.sh update
# =============================================================================

# ── Portas (expostas pelo Docker) ─────────────────────────────────────────────
PORT=3090                # LibreChat API
ADMIN_EXT_PORT=3092      # Admin backend
ADMIN_PANEL_PORT=3091    # Admin frontend
UID=1000
GID=1000

# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE=Navvia
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
DEFAULT_LANG=pt-BR

# ── URLs públicas ─────────────────────────────────────────────────────────────
# Usadas pelo admin-ext + admin-panel pra montar links e CORS.
LIBRECHAT_URL=https://app.navvia.com.br
ADMIN_PANEL_URL=https://admin.navvia.com.br
CORS_ORIGINS=https://app.navvia.com.br,https://admin.navvia.com.br

# URL interna Docker-to-Docker (server-to-server, evita egress pra internet).
# Como o admin-ext sobe na mesma rede `navvia_internal`, basta o nome do service.
LIBRECHAT_INTERNAL_URL=http://api:3080

# ── MongoDB (centralizado, fora deste compose) ────────────────────────────────
# Use o nome do container ou host do MongoDB centralizado.
MONGO_URI=mongodb://MONGO_USER:MONGO_PASS@mongodb_mongodb:27017/IXLab?authSource=IXLab

# ── Auth (compartilhado entre api e admin-ext) ───────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_EXPIRY=900000
REFRESH_TOKEN_EXPIRY=604800000

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILI_MASTER_KEY=

# ── Postgres + pgvector (RAG) ─────────────────────────────────────────────────
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
RAG_PORT=8000

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
TTS_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
JINA_API_KEY=
COHERE_API_KEY=

# ── Image Generation (xAI Imagine via agent tool) ────────────────────────────
IMAGE_GEN_OAI_API_KEY=
IMAGE_GEN_OAI_BASEURL=https://api.x.ai/v1/
IMAGE_GEN_OAI_MODEL=grok-imagine-image

# ── Email (password reset) ────────────────────────────────────────────────────
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ENCRYPTION=starttls
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Navvia

# ── Admin Panel build args (assados na imagem do nginx) ──────────────────────
VITE_EXT_URL=https://admin-api.navvia.com.br
VITE_LIBRECHAT_URL=
VITE_BRAND_NAME=Navvia
VITE_BRAND_COLOR=#2469E2

# ── Pagamentos (ASAAS) ────────────────────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_SANDBOX=false
ASAAS_WEBHOOK_TOKEN=

# ── Scheduler (admin-ext) ─────────────────────────────────────────────────────
CREDIT_SCHEDULER_CRON=0 * * * *
