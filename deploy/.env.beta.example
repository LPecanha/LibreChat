# =============================================================================
# Navvia BETA — env template
# =============================================================================
# Copia o .env do stack principal e SOBRESCREVE só o que precisa divergir:
#   - Port (não pode bater com o app)
#   - Volume paths (aponta pros caminhos do app no host)
#   - Scheduler desligado (admin-ext do app já roda o cron)
#
# Uso:
#   cp .env.beta.example .env
#   # depois edita pra apontar pros caminhos absolutos do app no servidor
# =============================================================================

# ── Beta-specific ─────────────────────────────────────────────────────────────
BETA_PORT=3093

# Paths ABSOLUTOS no host onde o stack principal armazena uploads e imagens.
# A beta monta os mesmos paths pra que arquivos enviados em qualquer instância
# fiquem acessíveis em ambas. Ajuste pra realidade do seu servidor.
APP_UPLOADS_DIR=/opt/navvia/deploy/data/uploads
APP_IMAGES_DIR=/opt/navvia/deploy/data/images

# ── App config (TUDO ABAIXO deve casar com o .env do stack principal) ────────
APP_TITLE=Navvia Beta
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
DEFAULT_LANG=pt-BR

# Mesmo Mongo do app
MONGO_URI=mongodb://MONGO_USER:MONGO_PASS@mongodb_mongodb:27017/IXLab?authSource=IXLab

# Mesmos secrets do app — habilita SSO entre app.* e beta.*
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_EXPIRY=900000
REFRESH_TOKEN_EXPIRY=604800000

# Mesmo Meili master key do app — a beta usa o meilisearch do stack principal
MEILI_MASTER_KEY=

RAG_PORT=8000

# ── AI Providers (idênticos ao app) ──────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
TTS_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
JINA_API_KEY=
COHERE_API_KEY=

# ── Image Generation ─────────────────────────────────────────────────────────
IMAGE_GEN_OAI_API_KEY=
IMAGE_GEN_OAI_BASEURL=https://api.x.ai/v1/
IMAGE_GEN_OAI_MODEL=grok-imagine-image

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ENCRYPTION=starttls
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Navvia
