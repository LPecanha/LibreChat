# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://app.navvia.com.br,https://admin.navvia.com.br

# ── Tenant config (single tenant: Navvia) ─────────────────────────────────────
# Mantido como JSON array por compatibilidade com o tipo TenantConfig, mas o
# admin-ext agora roda em modo single-tenant — só Navvia.
TENANTS_CONFIG=[{"id":"navvia","name":"Navvia","mongoUri":"mongodb://NAVVIA_USER:NAVVIA_PASS@mongodb_mongodb:27017/IXLab?authSource=IXLab","db":"IXLab","jwtSecret":"JWT_SECRET_DO_NAVVIA","origin":"https://app.navvia.com.br","librechatUrl":"http://librechat-navvia:3090"}]

# ── Admin panel build args ────────────────────────────────────────────────────
VITE_EXT_URL=https://admin-api.navvia.com.br
VITE_TENANTS=[{"id":"navvia","name":"Navvia","librechatUrl":"https://app.navvia.com.br"}]
VITE_LIBRECHAT_URL=
VITE_BRAND_NAME=Navvia
VITE_BRAND_COLOR=#2469E2

# ── Pagamentos (ASAAS) ────────────────────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_SANDBOX=false
# Token validado (timing-safe) no header asaas-access-token do webhook.
# Cadastre o MESMO valor no painel ASAAS → Configurações → Webhooks.
ASAAS_WEBHOOK_TOKEN=

# ── Scheduler ─────────────────────────────────────────────────────────────────
CREDIT_SCHEDULER_CRON=0 * * * *
