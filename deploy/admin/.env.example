# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://app.navvia.com.br,https://admin.navvia.com.br

# ── App config (single tenant: Navvia) ────────────────────────────────────────
# Conexão direta com o banco e secret do Navvia. Não há mais TENANTS_CONFIG —
# o admin-ext roda single-tenant.
MONGO_URI=mongodb://NAVVIA_USER:NAVVIA_PASS@mongodb_mongodb:27017/IXLab?authSource=IXLab
JWT_SECRET=JWT_SECRET_DO_NAVVIA
# URL pública do LibreChat (usada apenas como label/fallback). Server-to-server
# usa LIBRECHAT_INTERNAL_URL quando definida.
LIBRECHAT_URL=https://app.navvia.com.br
LIBRECHAT_INTERNAL_URL=http://librechat-navvia:3090

# ── Admin panel build args ────────────────────────────────────────────────────
VITE_EXT_URL=https://admin-api.navvia.com.br
VITE_LIBRECHAT_URL=https://app.navvia.com.br
VITE_BRAND_NAME=Navvia
VITE_BRAND_COLOR=#2469E2

# ── Pagamentos (ASAAS) ────────────────────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_SANDBOX=false
# Token validado (timing-safe) no header asaas-access-token do webhook.
# Cadastre o MESMO valor no painel ASAAS → Configurações → Webhooks.
ASAAS_WEBHOOK_TOKEN=

# ── Scheduler ─────────────────────────────────────────────────────────────────
CREDIT_SCHEDULER_CRON=0 * * * *
