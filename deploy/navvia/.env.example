# ── Server ────────────────────────────────────────────────────────────────────
PORT=3090
HOST=0.0.0.0
UID=1000
GID=1000

# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE=Navvia
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false

# ── MongoDB (centralizado) ────────────────────────────────────────────────────
# Use o nome do container ou host do MongoDB centralizado
MONGO_URI=mongodb://MONGO_USER:MONGO_PASS@mongodb_mongodb:27017/IXLab?authSource=IXLab

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_EXPIRY=900000
REFRESH_TOKEN_EXPIRY=604800000

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILI_MASTER_KEY=

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_PORT=8000

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Kimi / Moonshot — https://platform.kimi.ai
MOONSHOT_API_KEY=

# Z.ai / GLM — https://docs.z.ai
ZAI_API_KEY=
XAI_API_KEY=
TTS_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
JINA_API_KEY=
COHERE_API_KEY=

# ── UI Defaults ──────────────────────────────────────────────────────────────
DEFAULT_LANG=pt-BR

# ── Image Generation (agent tools) ───────────────────────────────────────────
# Uses xAI Imagine API via the image_gen_oai agent tool
IMAGE_GEN_OAI_API_KEY=      # same value as XAI_API_KEY
IMAGE_GEN_OAI_BASEURL=https://api.x.ai/v1/
IMAGE_GEN_OAI_MODEL=grok-imagine-image

# ── Email (password reset) ────────────────────────────────────────────────────
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ENCRYPTION=starttls
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Navvia

# ── Integração com admin-ext (créditos / cobrança) ────────────────────────────
# Escolha UM dos dois caminhos. Sem nenhum deles, a compra de créditos some da
# interface em silêncio — o hook `useExtProfile` testa `!!EXT_URL` e a rota /ext
# nem chega a ser montada.
#
# (a) RECOMENDADO — via proxy server-to-server. O navegador nunca fala direto
#     com o admin-ext, então ele não precisa estar exposto publicamente.
EXT_INTERNAL_URL=http://librechat-admin-ext:3092
#
# (b) Alternativa — chamada direta do navegador. Exige o admin-ext publicamente
#     acessível e a origem deste app listada em CORS_ORIGINS do deploy/admin.
# EXT_URL=https://admin-api.navvia.com.br
#
# Timeout do proxy para o admin-ext, em ms (default 15000).
# EXT_PROXY_TIMEOUT_MS=15000
#
# Segredo compartilhado com o admin-ext. Protege GET /api/ext-specs, por onde o
# admin-ext lê o catálogo de model specs. DEVE ser idêntico ao do deploy/admin.
# Gere com: openssl rand -hex 32
EXT_SHARED_SECRET=
